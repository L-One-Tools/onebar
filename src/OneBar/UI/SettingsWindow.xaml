<Window x:Class="OneBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OneBar 设置"
        Width="520" Height="610"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F4F4"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="OneBar 设置" FontSize="24" FontWeight="SemiBold" Foreground="#252A2D"/>
            <TextBlock Text="安装时的默认设置可在这里继续修改。" Margin="0,5,0,0" FontSize="12" Foreground="#70777B"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="运行" FontSize="13" FontWeight="SemiBold" Foreground="#343A3D" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,0,0,8"/>
                <CheckBox x:Name="TaskbarCheck" Content="显示任务栏运行图标" Margin="0,0,0,8"/>
                <CheckBox x:Name="TrayCheck" Content="显示系统托盘图标" Margin="0,0,0,8"/>
                <CheckBox x:Name="DesktopCheck" Content="创建桌面快捷方式" Margin="0,0,0,8"/>
                <CheckBox x:Name="StartMenuCheck" Content="创建开始菜单入口" Margin="0,0,0,18"/>

                <TextBlock Text="关闭键" FontSize="13" FontWeight="SemiBold" Foreground="#343A3D" Margin="0,0,0,8"/>
                <ComboBox x:Name="CloseActionCombo" Height="32" Margin="0,0,0,18">
                    <ComboBoxItem Content="关闭窗口，OneBar 继续运行" Tag="hide"/>
                    <ComboBoxItem Content="退出 OneBar" Tag="exit"/>
                </ComboBox>

                <TextBlock Text="自动回收" FontSize="13" FontWeight="SemiBold" Foreground="#343A3D" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="离开后停留（ms）" FontSize="11" Foreground="#70777B" Margin="0,0,0,4"/>
                        <TextBox x:Name="DelayBox" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="回收动画（ms）" FontSize="11" Foreground="#70777B" Margin="0,0,0,4"/>
                        <TextBox x:Name="AnimBox" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="工作流目录" FontSize="13" FontWeight="SemiBold" Foreground="#343A3D" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="78"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkflowRootBox" Grid.Column="0" Height="32" VerticalContentAlignment="Center" FontSize="11"/>
                    <Button Grid.Column="2" Content="浏览…" Height="32" Click="BrowseWorkflow_OnClick"/>
                </Grid>
                <TextBlock Text="切换到空目录时，会复制当前工作流；原目录保留。" FontSize="10.5" Foreground="#7A8185" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="打开工作流文件夹" Width="150" Height="32" Margin="0,0,8,0" Click="OpenWorkflow_OnClick"/>
                    <Button Content="打开安装目录" Width="130" Height="32" Click="OpenInstall_OnClick"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Width="92" Height="34" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="保存设置" Width="108" Height="34" IsDefault="True" Click="Save_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
